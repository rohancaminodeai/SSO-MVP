# SSO MVP — example environment. Copy to .env for local dev.
# Pinned token constants live in packages/common/src/config.ts, not here.

# --- Identity Provider (auth-service) ---
ISSUER=http://localhost:8000
AUDIENCE=platform-tenants

# --- Databases (one per service) ---
# docker-compose creates these three databases in a single Postgres instance.
AUTH_DATABASE_URL=postgres://sso:sso@localhost:5432/auth_db
TENANT_A_DATABASE_URL=postgres://sso:sso@localhost:5432/tenant_a_db
TENANT_B_DATABASE_URL=postgres://sso:sso@localhost:5432/tenant_b_db

# --- tenant-service: which tenant this instance is ("one image, many roles") ---
# Set per container; valid values: tenant_a | tenant_b
TENANT_ID=tenant_a

# --- Phase 2 (added later): IdP session cookie signing secret ---
# COOKIE_SECRET=change-me-in-prod
