{
  "name": "sso-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SSO MVP — Single Point of Authentication (study project, Node + TypeScript)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
